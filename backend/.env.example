# ---- Database ----
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"
CORS_ORIGINS="*"

# ---- Contact-form email notifications (OPTIONAL) ----
# Leave SMTP_HOST empty to run database-only (submissions are still saved).
# Fill these in to also receive an email for every submission:
#   SMTP_HOST: your SMTP server, e.g. smtp.gmail.com
#   SMTP_PORT: 465 (SSL) or 587 (STARTTLS)
#   SMTP_USER / SMTP_PASSWORD: SMTP login credentials
#   SMTP_FROM_EMAIL: address emails are sent from (defaults to SMTP_USER)
#   SMTP_FROM_NAME: display name (defaults to "CreativeVox Website")
#   CONTACT_TO_EMAIL: inbox that receives notifications (defaults to team@creativevoxmedia.com)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="CreativeVox Website"
CONTACT_TO_EMAIL="team@creativevoxmedia.com"
